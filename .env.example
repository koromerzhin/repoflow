# ---------------------------------------------------------------
# RepoFlow — variables d'environnement (exemple)
# Copier ce fichier vers .env puis adapter les valeurs.
# AUCUN SECRET RÉEL ne doit figurer dans ce fichier versionné.
# ---------------------------------------------------------------

# --- Backend (FastAPI) ---
# Préfixe des variables backend : REPOFLOW_

# Nom affiché et environnement d'exécution.
REPOFLOW_APP_NAME=RepoFlow
REPOFLOW_ENVIRONMENT=development
REPOFLOW_LOG_LEVEL=INFO

# URL de la base de données. SQLite pour le développement.
REPOFLOW_DATABASE_URL=sqlite+pysqlite:///./repoflow.db
# Crée automatiquement les tables au démarrage (pratique en développement).
REPOFLOW_AUTO_CREATE_TABLES=true

# Origines autorisées pour CORS (séparées par des virgules).
REPOFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Intégration GitHub ---
# Fournisseur de données : "demo" (aucun token requis) ou "github".
REPOFLOW_GITHUB_PROVIDER=demo

# Token GitHub côté serveur UNIQUEMENT. Ne jamais l'exposer au frontend
# ni le journaliser. Laisser vide en mode démonstration.
# Portée recommandée (à valider ultérieurement) : lecture seule des dépôts,
# issues et pull requests.
REPOFLOW_GITHUB_TOKEN=

# URL de base de l'API GitHub (utile pour GitHub Enterprise).
REPOFLOW_GITHUB_API_URL=https://api.github.com

# --- Sécurité / fusion ---
# La fusion automatique est désactivée par défaut. Ne pas activer en v0.1.
REPOFLOW_AUTO_MERGE_ENABLED_GLOBALLY=false
# Arrêt d'urgence global (à utiliser pour suspendre toute automatisation).
REPOFLOW_KILL_SWITCH_ENGAGED=false

# --- Frontend (Vite) ---
# Les variables frontend doivent être préfixées par VITE_.
# URL de base de l'API consommée par le navigateur.
VITE_API_BASE_URL=/api

# Cible du proxy Vite en développement (le backend depuis Docker Compose).
VITE_PROXY_TARGET=http://localhost:8000
