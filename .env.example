# ---------------------------------------------------------------
# RepoFlow — variables d'environnement (exemple)
# Copier ce fichier vers .env puis adapter les valeurs.
# AUCUN SECRET RÉEL ne doit figurer dans ce fichier versionné.
# ---------------------------------------------------------------

# --- Backend (FastAPI) ---
# Préfixe des variables backend : REPOFLOW_

# Nom affiché et environnement d'exécution.
REPOFLOW_APP_NAME=RepoFlow
REPOFLOW_ENVIRONMENT=development
REPOFLOW_LOG_LEVEL=INFO

# URL de la base de données. SQLite pour le développement.
# # PostgreSQL (production) : installer le support puis décommenter :
#   pip install -e ".[postgres]"
#   REPOFLOW_DATABASE_URL=postgresql+psycopg://repoflow:motdepasse@localhost:5432/repoflow
REPOFLOW_DATABASE_URL=sqlite+pysqlite:///./repoflow.db
# Mot de passe du service PostgreSQL du docker-compose (profil "postgres").
REPOFLOW_DB_PASSWORD=repoflow
# Crée automatiquement les tables au démarrage (pratique en développement).
REPOFLOW_AUTO_CREATE_TABLES=true

# Réglages de pool SQLAlchemy (PostgreSQL et autres bases non-SQLite).
REPOFLOW_DB_POOL_PRE_PING=true
REPOFLOW_DB_POOL_SIZE=5
REPOFLOW_DB_MAX_OVERFLOW=10

# Origines autorisées pour CORS (séparées par des virgules).
REPOFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Intégration GitHub ---
# Fournisseur de données : "demo" (aucun token requis) ou "github".
REPOFLOW_GITHUB_PROVIDER=demo

# Token GitHub côté serveur UNIQUEMENT. Ne jamais l'exposer au frontend
# ni le journaliser. Laisser vide en mode démonstration.
# Portée recommandée (à valider ultérieurement) : lecture seule des dépôts,
# issues et pull requests.
# Priorité : si la GitHub App est configurée ci-dessous, ce token est ignoré.
REPOFLOW_GITHUB_TOKEN=

# --- GitHub App (optionnel, prioritaire sur le token ci-dessus) ---
# Authentification par jeton d'installation : quota de 15 000 requêtes/heure
# (contre 5 000 pour un token personnel), renouvellement automatique.
# REPOFLOW_GITHUB_APP_ID : identifiant numérique de l'application.
REPOFLOW_GITHUB_APP_ID=
# Clé privée de l'application : PEM complet (les \n échappés sont acceptés)
# ou PEM encodé en base64. Ne jamais la committer ni la journaliser.
REPOFLOW_GITHUB_APP_PRIVATE_KEY=
# Identifiant de l'installation de l'application sur l'organisation.
REPOFLOW_GITHUB_APP_INSTALLATION_ID=

# Transport GraphQL pour la liste des pull requests : 1 requête par page
# (checks CI et revues incluses) au lieu de 4-5 requêtes par pull request.
# Nécessaire si le nombre de PR suit est élevé ou si le quota est serré.
REPOFLOW_GITHUB_USE_GRAPHQL=false

# URL de base de l'API GitHub (utile pour GitHub Enterprise).
REPOFLOW_GITHUB_API_URL=https://api.github.com

# Réglages du client HTTP GitHub (lecture seule).
# Délai d'attente maximal d'une requête, en secondes.
REPOFLOW_GITHUB_TIMEOUT=30
# Nombre d'éléments par page (1 à 100).
REPOFLOW_GITHUB_PER_PAGE=100
# Nombre maximal de pages suivies par ressource (garde-fou anti-boucle).
REPOFLOW_GITHUB_MAX_PAGES=10

# Durée de mise en cache mémoire des données du fournisseur, en secondes
# (0 pour désactiver). Un rafraîchissement manuel via `?refresh=true` force
# le rechargement.
REPOFLOW_CACHE_TTL_SECONDS=30

# --- Sécurité / fusion ---
# La fusion automatique est désactivée par défaut. Même activée globalement,
# elle n'a lieu que si une règle du dépôt l'autorise explicitement, que la PR
# est éligible et que l'arrêt d'urgence est désengagé. En cas de doute, laisser
# à "false".
REPOFLOW_AUTO_MERGE_ENABLED_GLOBALLY=false
# Arrêt d'urgence global (à utiliser pour suspendre toute automatisation).
# Une fois engagé via l'environnement, il prévaut sur toute configuration.
REPOFLOW_KILL_SWITCH_ENGAGED=false

# --- Worker d'analyse (Phase 4) ---
# Analyse périodique des dépôts suivis et application des règles. Désactivé
# par défaut. Peut aussi être lancé manuellement : `python -m app.worker`.
REPOFLOW_WORKER_ENABLED=false
# Intervalle entre deux passes d'analyse, en secondes.
REPOFLOW_WORKER_INTERVAL_SECONDS=300
# Rétention du journal d'audit, en jours (0 = illimitée).
# La purge s'exécute à chaque passe du worker.
REPOFLOW_AUDIT_RETENTION_DAYS=0

# --- Observabilité (Phase 5) ---
# Journal d'accès et identifiant de corrélation (en-tête X-Request-ID) :
# toujours actifs. Exposition des métriques Prometheus sur /api/metrics.
REPOFLOW_METRICS_ENABLED=true

# --- Durcissement sécurité (Phase 5) ---
# En-têtes de sécurité HTTP (X-Content-Type-Options, CSP sur l'API, etc.).
REPOFLOW_SECURITY_HEADERS_ENABLED=true
# Strict-Transport-Security : UNIQUEMENT en HTTPS (désactivé en dev).
REPOFLOW_HSTS_ENABLED=false
# Limitation de débit par adresse IP (fenêtre fixe en mémoire). Désactivée par
# défaut. Derrière un proxy, activer avantage la protection anti-abus.
REPOFLOW_RATE_LIMIT_ENABLED=false
REPOFLOW_RATE_LIMIT_REQUESTS=120
REPOFLOW_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (Vite) ---
# Les variables frontend doivent être préfixées par VITE_.
# URL de base de l'API consommée par le navigateur.
VITE_API_BASE_URL=/api

# Cible du proxy Vite en développement (le backend depuis Docker Compose).
VITE_PROXY_TARGET=http://localhost:8000
